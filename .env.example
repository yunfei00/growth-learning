# Copy this file to .env and replace every local-only placeholder before sharing an environment.
COMPOSE_PROJECT_NAME=growth-learning

# PostgreSQL (use URL-safe values because Compose builds DATABASE_URL from these variables)
POSTGRES_USER=growth_learning
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=growth_learning

# MinIO
MINIO_ROOT_USER=growth_learning
MINIO_ROOT_PASSWORD=local-minio-change-me
MINIO_BUCKET=growth-learning
SCIENCE_IMAGE_MAX_BYTES=10485760
SCIENCE_VIDEO_MAX_BYTES=52428800
SCIENCE_AUDIO_MAX_BYTES=20971520

# Applications. PostgreSQL, Redis, and MinIO stay on the private Compose network.
APP_ENVIRONMENT=production
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_APP_BASE_PATH=
API_ROOT_PATH=
FRONTEND_BUILD_NODE_OPTIONS=--max-old-space-size=512

# Browser authentication. Generate a unique random value on every real server.
AUTH_SECRET=local-only-auth-secret-change-me-please
AUTH_COOKIE_NAME=growth_learning_session
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_TTL_SECONDS=604800
REGISTRATION_MODE=invite_only
# Optional dedicated HMAC key; if empty, AUTH_SECRET is used.
INVITATION_CODE_SECRET=
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTRATION_RATE_LIMIT=5

# Text AI is disabled by default. Existing DeepSeek/OpenAI-compatible settings stay independent
# from speech recognition. Browser bundles never receive these server-only values.
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_STORY_MAX_ATTEMPTS=3
EXPORT_DOWNLOAD_TTL_SECONDS=3600

# High-accuracy server ASR for the representative literacy diagnostic.
# Keep the API key only in the production server .env; never commit a real key.
# The generic Beijing DashScope domain remains supported; a workspace-specific
# Bailian domain can be supplied here later without code changes.
LITERACY_ASR_PROVIDER=disabled
LITERACY_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
LITERACY_ASR_API_KEY=
LITERACY_ASR_MODEL=qwen-audio-3.0-asr-flash
LITERACY_ASR_TIMEOUT_SECONDS=15
LITERACY_ASR_MAX_AUDIO_BYTES=2097152

# Browser SpeechRecognition is an experimental daily-review enhancement and a
# diagnostic fallback. It never stores raw audio and can be disabled without
# affecting parent-manual review.
CHARACTER_SPEECH_REVIEW_ENABLED=false