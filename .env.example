# Copy this file to .env and replace every local-only placeholder before sharing an environment.
COMPOSE_PROJECT_NAME=growth-learning

# PostgreSQL (use URL-safe values because Compose builds DATABASE_URL from these variables)
POSTGRES_USER=growth_learning
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=growth_learning

# MinIO
MINIO_ROOT_USER=growth_learning
MINIO_ROOT_PASSWORD=local-minio-change-me
MINIO_BUCKET=growth-learning

# Applications. PostgreSQL, Redis, and MinIO stay on the private Compose network.
APP_ENVIRONMENT=production
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_APP_BASE_PATH=
API_ROOT_PATH=
FRONTEND_BUILD_NODE_OPTIONS=--max-old-space-size=512

# Browser authentication. Generate a unique random value on every real server.
AUTH_SECRET=local-only-auth-secret-change-me-please
AUTH_COOKIE_NAME=growth_learning_session
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_TTL_SECONDS=604800

# AI is disabled by default. Browser bundles never receive these server-only values.
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_STORY_MAX_ATTEMPTS=3
