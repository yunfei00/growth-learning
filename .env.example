# Copy this file to .env and replace every local-only placeholder before sharing an environment.
COMPOSE_PROJECT_NAME=growth-learning

# PostgreSQL (use URL-safe values because Compose builds DATABASE_URL from these variables)
POSTGRES_USER=growth_learning
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=growth_learning

# MinIO
MINIO_ROOT_USER=growth_learning
MINIO_ROOT_PASSWORD=local-minio-change-me
MINIO_BUCKET=growth-learning

# Applications. PostgreSQL, Redis, and MinIO stay on the private Compose network.
APP_ENVIRONMENT=production
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_BUILD_NODE_OPTIONS=--max-old-space-size=768

# AI is disabled by default. No real model is called in Phase 1.
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
